{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "waiting-trucks-ms-browser-test",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "keep_vars": true,
  "browser": {
    "binding": "BROWSER",
  },
  "kv_namespaces": [{ "binding": "STATE" }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
  },
}
