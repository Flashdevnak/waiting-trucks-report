{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waiting-trucks-report-api-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "assets": {
    "directory": "./.dev-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "MS_BRANCH": "NE1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MS_REFRESH_COORDINATOR",
        "class_name": "MsRefreshCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "dev-ms-refresh-coordinator-v1",
      "new_sqlite_classes": ["MsRefreshCoordinator"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waiting-trucks-report-dev-db",
      "database_id": "798db282-46cd-4b2c-bfca-3d6d29596451",
      "migrations_dir": "migrations"
    }
  ]
}
