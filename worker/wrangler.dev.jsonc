{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waiting-trucks-report-api-dev",
  "main": "src/turso-index.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "assets": {
    "directory": "./.dev-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "MS_BRANCH": "NE1",
    "DB_BACKEND": "turso"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MS_REFRESH_COORDINATOR",
        "class_name": "MsRefreshCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "dev-ms-refresh-coordinator-v1",
      "new_sqlite_classes": ["MsRefreshCoordinator"]
    }
  ]
}
